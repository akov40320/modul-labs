<mxfile host="app.diagrams.net" modified="2026-10-04T00:00:00.000Z" agent="Local teaching artifact" version="24.0.0" type="device"><diagram id="modul-flow" name="User Flow - Модуль"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n0" value="Пользователь открывает лендинг" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6f7ee;strokeColor=#2d9a60;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="30" width="260" height="60" as="geometry" /></mxCell><mxCell id="n1" value="Понимает предложение: hero, продукт, FAQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ff;strokeColor=#2449c8;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="140" width="260" height="70" as="geometry" /></mxCell><mxCell id="n2" value="Переходит в каталог и выбирает направление" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ff;strokeColor=#2449c8;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="270" width="260" height="70" as="geometry" /></mxCell><mxCell id="n3" value="Поиск / фильтр цены / сортировка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ff;strokeColor=#2449c8;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="400" width="260" height="70" as="geometry" /></mxCell><mxCell id="n4" value="Найден подходящий набор?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#c5a428;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="220" height="110" as="geometry" /></mxCell><mxCell id="n5" value="Сбрасывает или меняет фильтры" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ff;strokeColor=#2449c8;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="535" width="220" height="70" as="geometry" /></mxCell><mxCell id="n6" value="Просматривает карточку и минимальную партию" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ff;strokeColor=#2449c8;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="540" y="680" width="260" height="70" as="geometry" /></mxCell><mxCell id="n7" value="Заполняет форму запроса" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ff;strokeColor=#2449c8;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="930" y="680" width="250" height="70" as="geometry" /></mxCell><mxCell id="n8" value="Поля валидны и есть согласие?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4cc;strokeColor=#c5a428;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="945" y="530" width="220" height="110" as="geometry" /></mxCell><mxCell id="n9" value="Показываются ошибки у полей" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ff;strokeColor=#2449c8;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1210" y="545" width="210" height="70" as="geometry" /></mxCell><mxCell id="n10" value="Сохраняется учебная заявка в localStorage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ff;strokeColor=#2449c8;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="930" y="400" width="250" height="70" as="geometry" /></mxCell><mxCell id="n11" value="Открывает кабинет: просмотр / экспорт / удаление" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3ff;strokeColor=#2449c8;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="930" y="270" width="250" height="70" as="geometry" /></mxCell><mxCell id="n12" value="Сценарий приложения завершен" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e6f7ee;strokeColor=#2d9a60;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="930" y="140" width="250" height="70" as="geometry" /></mxCell><mxCell id="note" value="Приложение опубликовано; заявки сайта — localStorage. Яндекс Форма — отдельный канал. Маке